#--------------------------------------------------------------------
# GYMLOG - CONFIGURAZIONE LOCALE
# Copia questo file in ".env" e cambia i valori per il tuo PC.
# Il file .env NON va mai su GitHub (contiene password).
#--------------------------------------------------------------------

# development = vedi gli errori e la debug bar | production = online
CI_ENVIRONMENT = development

# L'indirizzo dove apri l'app (con "php spark serve" è questo)
app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE (MySQL / MariaDB - es. XAMPP, Laragon, MAMP)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = gymlog
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# CHIAVE DI CRITTOGRAFIA
# Generala con: php spark key:generate
#--------------------------------------------------------------------
# encryption.key =
